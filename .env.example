# LiteLLM API Key Pool (Comma-separated, at least 2 keys. key_1, key_2, ...)
LLM_API_KEYS=your_primary_api_key_here,your_secondary_fallback_key_here

# Model identifier for LiteLLM (e.g. gemini/gemini-2.0-flash, gpt-4o-mini, groq/llama-3.1-70b-versatile)
LLM_MODEL=gemini/gemini-2.0-flash

# SQLite storage location (persistent volume in docker)
DATABASE_URL=sqlite:////data/app.db

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable failover test hook via X-Simulate-Failure header
ENABLE_FAILURE_SIMULATION=true

# Optional: Default system prompt
DEFAULT_SYSTEM_PROMPT=You are a helpful, friendly, and concise AI assistant.

# Frontend backend URL
VITE_BACKEND_URL=http://localhost:8000
